.app {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  max-width: 900rpx;
  margin: 0 auto;
  min-height: 100vh;
  box-sizing: border-box;
}

.title {
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  padding: 20rpx 0 32rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.picker {
  flex: 1;
}

.picker-view {
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 模式切换 */
.mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #cfe0ff;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  transition: all 0.2s;
}

.mode-tab.active {
  color: #fff;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.25);
  border-color: rgba(255, 255, 255, 0.5);
  transform: scale(1.03);
}

.mode-info {
  flex: 1;
  font-size: 26rpx;
  color: #cde3ff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 自定义难度 */
.custom-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.custom-field {
  flex: 1;
}

.custom-label {
  font-size: 22rpx;
  color: #b9d4ff;
  margin-bottom: 8rpx;
}

.custom-input {
  padding: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
  width: 100%;
}

.btn-apply {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #11998e, #38ef7d);
}

/* 道具栏 */
.prop-card {
  padding: 20rpx 22rpx;
}

.prop-row {
  display: flex;
  gap: 14rpx;
}

.prop {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 14rpx 4rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.prop.on {
  color: #fff;
  background: rgba(17, 153, 142, 0.45);
  border-color: rgba(56, 237, 125, 0.6);
}

.prop.off {
  color: rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.08);
}

.prop-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ffe08a;
  text-align: center;
}

.btn {
  border: none;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 2.4;
  margin: 0;
}

.btn-start {
  flex: 1;
  background: linear-gradient(135deg, #11998e, #38ef7d);
}

.btn-main {
  flex: 1.4;
  background: linear-gradient(135deg, #fc4a1a, #f7b733);
}

.btn-exit {
  flex: 1;
  background: linear-gradient(135deg, #a71d31, #e03e3e);
}

.btn-danger {
  background: linear-gradient(135deg, #a71d31, #e03e3e);
  margin-top: 20rpx;
}

.btn[disabled] {
  opacity: 0.45;
  color: #fff;
  background: #666;
}

.btn.full {
  flex: none;
  width: 100%;
  margin-top: 20rpx;
}

.btn-small {
  flex: none;
  width: 160rpx;
  line-height: 2;
  font-size: 26rpx;
  background: linear-gradient(135deg, #11998e, #38ef7d);
  margin-left: 16rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #cde3ff;
  margin-bottom: 16rpx;
}

.guess-input {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 36rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.guess-input[disabled] {
  opacity: 0.5;
}

.stats {
  display: flex;
  justify-content: space-between;
}

.stat {
  flex: 1;
  text-align: center;
  overflow: hidden;
}

.stat .num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat .label {
  font-size: 24rpx;
  color: #b9d4ff;
}

.status {
  text-align: center;
  min-height: 92rpx;
  line-height: 1.6;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status.good {
  background: rgba(56, 237, 125, 0.25);
}

.status.bad {
  background: rgba(224, 62, 62, 0.25);
}

.status.up {
  background: rgba(255, 179, 71, 0.22);
}

.status.down {
  background: rgba(127, 182, 255, 0.22);
}

.status.tip {
  background: rgba(255, 224, 138, 0.25);
}

.best {
  margin-bottom: 12rpx;
}

.best .num {
  font-size: 32rpx;
}

.history-title {
  font-size: 26rpx;
  color: #b9d4ff;
  margin-bottom: 16rpx;
  text-align: center;
}

.history {
  max-height: 340rpx;
}

.history-item {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 28rpx;
}

.history-item text {
  float: right;
  font-style: normal;
}

.ok {
  color: #38ef7d;
}

.up {
  color: #ffb347;
}

.down {
  color: #7fb6ff;
}

.tip {
  color: #ffe08a;
}

.bad {
  color: #ff6b6b;
}

.empty {
  text-align: center;
  color: rgba(255, 255, 255, 0.45);
  font-size: 26rpx;
  padding: 24rpx 0;
}

/* 底部菜单 */
.foot {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0;
}

.btn-foot {
  flex: 1;
  min-width: 200rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  line-height: 2.2;
  font-size: 26rpx;
}

.btn-foot::after {
  border: none;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  background: rgba(30, 60, 114, 0.97);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 28rpx 32rpx 40rpx;
  z-index: 11;
  overflow-y: auto;
  box-sizing: border-box;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.3);
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.sheet .stats {
  margin-bottom: 20rpx;
}

.sheet .stat .num {
  font-size: 40rpx;
}

/* 排行榜卡片 */
.rank-scroll {
  max-height: 52vh;
}

.rank-head,
.rank-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.rank-c-rank,
.rank-c-score,
.rank-c-mode,
.rank-c-time,
.rank-c-date {
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rank-c-rank {
  width: 70rpx;
  flex: none;
}

.rank-c-score {
  width: 90rpx;
  flex: none;
  color: #ffd166;
  font-weight: 700;
}

.rank-c-mode {
  flex: 2;
  padding: 0 8rpx;
  color: #cde3ff;
}

.rank-c-time {
  flex: 1;
  color: #b9d4ff;
}

.rank-c-date {
  flex: 1;
  text-align: right;
  color: #b9d4ff;
}

.rank-diff {
  font-size: 20rpx;
}

.rank-head {
  color: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.rank-top {
  display: flex;
  align-items: center;
}

.rank-no {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.rank-no.top {
  background: linear-gradient(135deg, #f7b733, #fc4a1a);
  color: #fff;
}

.rank-score {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffd166;
  margin-right: 16rpx;
}

.rank-nick {
  flex: 1;
  font-size: 26rpx;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: right;
}

.rank-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b9d4ff;
}

/* 对局记录 */
.log-scroll {
  max-height: 52vh;
}

.log-item {
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.log-line {
  font-size: 28rpx;
  color: #fff;
}

.log-line text {
  float: right;
  color: #ffd166;
}

.log-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b9d4ff;
}

/* 成就徽章 */
.achv-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.achv-item {
  width: 47%;
  text-align: center;
  border-radius: 20rpx;
  padding: 18rpx 10rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  box-sizing: border-box;
}

.achv-item.unlocked {
  background: rgba(56, 237, 125, 0.12);
  border-color: rgba(56, 237, 125, 0.5);
}

.achv-item.locked {
  opacity: 0.5;
}

.achv-icon {
  font-size: 60rpx;
}

.achv-name {
  font-size: 28rpx;
  font-weight: 700;
  margin: 8rpx 0 4rpx;
}

.achv-desc {
  font-size: 22rpx;
  color: #b9d4ff;
}

/* 每日挑战 */
.daily-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.set-desc {
  font-size: 26rpx;
  color: #b9d4ff;
  margin-bottom: 20rpx;
}

.set-desc.center {
  text-align: center;
}

/* 海报 */
.poster-wrap {
  width: 300px;
  height: 450px;
  margin: 0 auto 20rpx;
  overflow: hidden;
  position: relative;
}

.poster-canvas {
  position: absolute;
  top: 0;
  left: 0;
  transform: scale(0.5);
  transform-origin: top left;
  border-radius: 16rpx;
}

.poster-img {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.poster-photo {
  width: 300px;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);
}

/* 设置 */
.set-title {
  font-size: 28rpx;
  color: #ffd166;
  margin: 20rpx 0 12rpx;
}

.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.nick-input {
  flex: 1;
  padding: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.theme-row {
  display: flex;
  justify-content: space-between;
}

.theme-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 4rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
}

.theme-item.active {
  border-color: #ffd166;
  background: rgba(255, 255, 255, 0.12);
}

.theme-swatch {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  margin: 0 auto 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
}

.theme-name {
  font-size: 24rpx;
  color: #cde3ff;
}

/* 新手引导 */
.guide-step {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 1.5;
}

.guide-n {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #f7b733, #fc4a1a);
  color: #fff;
  font-weight: 700;
  margin-right: 16rpx;
}