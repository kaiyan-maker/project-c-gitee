.app {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  max-width: 900rpx;
  margin: 0 auto;
}

.title {
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  padding: 20rpx 0 32rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.picker {
  flex: 1;
}

.picker-view {
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.btn {
  border: none;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 2.4;
  margin: 0;
}

.btn-start {
  flex: 1;
  background: linear-gradient(135deg, #11998e, #38ef7d);
}

.btn-main {
  flex: 1.4;
  background: linear-gradient(135deg, #fc4a1a, #f7b733);
}

.btn-exit {
  flex: 1;
  background: linear-gradient(135deg, #a71d31, #e03e3e);
}

.btn[disabled] {
  opacity: 0.45;
  color: #fff;
  background: #666;
}

.hint-text {
  font-size: 28rpx;
  color: #cde3ff;
  margin-bottom: 16rpx;
}

.guess-input {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 36rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.guess-input[disabled] {
  opacity: 0.5;
}

.stats {
  display: flex;
  justify-content: space-between;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat .num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat .label {
  font-size: 24rpx;
  color: #b9d4ff;
}

.status {
  text-align: center;
  min-height: 92rpx;
  line-height: 1.6;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status.good {
  background: rgba(56, 237, 125, 0.25);
}

.status.bad {
  background: rgba(224, 62, 62, 0.25);
}

.status.up {
  background: rgba(255, 179, 71, 0.22);
}

.status.down {
  background: rgba(127, 182, 255, 0.22);
}

.status.tip {
  background: rgba(255, 224, 138, 0.25);
}

.best {
  margin-bottom: 12rpx;
}

.history-title {
  font-size: 26rpx;
  color: #b9d4ff;
  margin-bottom: 16rpx;
  text-align: center;
}

.history {
  max-height: 340rpx;
}

.history-item {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 28rpx;
}

.history-item text {
  float: right;
  font-style: normal;
}

.ok {
  color: #38ef7d;
}

.up {
  color: #ffb347;
}

.down {
  color: #7fb6ff;
}